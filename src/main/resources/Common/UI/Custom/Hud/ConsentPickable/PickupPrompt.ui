Group #PickupPromptRoot {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  LayoutMode: Top;

  Group #PosTop { FlexWeight: 535; }

  Group #CenterRow {
    Anchor: (Left: 0, Right: 0);
    LayoutMode: Center;

    Group #PickupPanel {
      Anchor: (Width: 320);
      LayoutMode: Left;
      Padding: (Horizontal: 0, Vertical: 0);
      Background: #0a1424(0.70);
      OutlineColor: #4ea8ff(0.75);
      OutlineSize: 1;

      Group #LeftAccent {
        Anchor: (Width: 3, Top: 0, Bottom: 0);
        Background: #5cb8ff;
      }

      Group #ContentRow {
        FlexWeight: 1;
        LayoutMode: Left;
        Padding: (Horizontal: 12, Vertical: 8);

        Group #KeyCap {
          Anchor: (Width: 32, Height: 32, Right: 10);
          LayoutMode: MiddleCenter;
          Background: #122238(0.85);
          OutlineColor: #5cb8ff(0.80);
          OutlineSize: 1;

          Label #ActionKey {
            Style: (FontSize: 13, TextColor: #e6f4ff, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
            Text: "F";
          }
        }

        Group #InfoCol {
          FlexWeight: 1;
          LayoutMode: Top;

          Label #ActionTitle {
            Anchor: (Left: 0, Right: 0, Height: 14);
            Style: (FontSize: 11, TextColor: #7ec8f8, RenderBold: true, RenderUppercase: true, LetterSpacing: 1, VerticalAlignment: Center);
            Text: "PICK UP";
          }

          Group #ItemRow {
            Anchor: (Left: 0, Right: 0, Height: 20);
            LayoutMode: Left;

            Label #ItemName {
              FlexWeight: 1;
              Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
              Text: "";
            }

            Label #ItemCount {
              Anchor: (Width: 44, Height: 20);
              Style: (FontSize: 14, TextColor: #7ec8f8, RenderBold: true, HorizontalAlignment: End, VerticalAlignment: Center);
              Text: "";
            }
          }
        }
      }
    }
  }

  Group #PosBottom { FlexWeight: 465; }
}
